# Salin file ini menjadi .env (khusus untuk Docker Compose). Jangan commit file .env.
# Password awal akun admin. Kosongkan agar dibuat acak dan ditampilkan di log saat pertama jalan.
ADMIN_PASSWORD=
# Isi 1 jika aplikasi diakses lewat HTTPS. Isi 0 jika masih lewat http (mis. jaringan lokal).
COOKIE_SECURE=0
# Isi 1 hanya jika berada di belakang reverse proxy (Caddy, Nginx, Cloudflare Tunnel).
TRUST_PROXY=
